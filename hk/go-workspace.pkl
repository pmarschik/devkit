// Shared hk config for a multi-module Go repo. A consumer's .config/hk.pkl is
// one line:
//
//   amends "https://raw.githubusercontent.com/pmarschik/devkit/v1/hk/go-workspace.pkl"
//
// This is hk/go.pkl plus one setting, so read that file for everything else.
// The amends below is relative, which resolves against the URL this file was
// fetched from and so stays on the ref the consumer pinned.
amends "go.pkl"

// workspace_indicator = "go.work" makes hk run golangci-lint once from the repo
// root rather than once per module in parallel, which collides on the
// golangci-lint lock. It also keeps {{workspace}} equal to the repo root, so
// the relative -c path in go.pkl resolves.
//
// hk skips a step whose indicator file is missing, in silence and with a clean
// exit, so this setting lives here rather than in go.pkl: a repo without a
// go.work would otherwise lose its lint step and never be told.
//
// The five hooks below are the ones whose step list holds golangci_lint. The
// fmt hook runs formatters only.
hooks {
    ["pre-commit"] { steps { ["golangci_lint"] { workspace_indicator = "go.work" } } }
    ["pre-push"]   { steps { ["golangci_lint"] { workspace_indicator = "go.work" } } }
    ["lint"]       { steps { ["golangci_lint"] { workspace_indicator = "go.work" } } }
    ["fix"]        { steps { ["golangci_lint"] { workspace_indicator = "go.work" } } }
    ["check"]      { steps { ["golangci_lint"] { workspace_indicator = "go.work" } } }
}
