#!/usr/bin/env bash
#MISE description="Prepare the release for review before running release:push"
#MISE sources=["CHANGELOG.md", "**/go.mod", "go.work"]
#MISE outputs=["CHANGELOG.md", "**/go.mod", "go.work"]
#USAGE flag "-f --force"          help="Skip all pre-flight checks"
#USAGE flag "--skip-clean"        help="Skip dirty working tree check"
#USAGE flag "--skip-cog"          help="Skip cog conventional commit check"
#USAGE flag "--highlights <text>" help="Release highlights (shown at top of changelog section)"
set -euo pipefail
# shellcheck source=../_lib.sh
source "$(dirname "$0")/../_lib.sh"

FORCE="${usage_force:-false}"
SKIP_CLEAN="${usage_skip_clean:-false}"
SKIP_COG="${usage_skip_cog:-false}"
HIGHLIGHTS="${usage_highlights:-}"
[[ "${FORCE}" == "true" ]] && warn "Pre-flight checks skipped (--force)"

echo ""
echo -e "${bold}📝 Preparing release…${reset}"
echo ""

CLIFF="git cliff --config .config/cliff.toml"

# ── detect VCS + dirty check ──────────────────────────────────────────────────
detect_vcs
info "VCS: ${VCS}"
CLIFF_REV=()
[[ -n "${JJ_HEAD}" ]] && CLIFF_REV=("${JJ_HEAD}")

# Re-running prepare on a release commit re-does the same release rather than
# bumping past it: under jj the commit is already described and tagged, and
# asking git cliff again would answer with the version after this one.
version=""
if [[ "${VCS}" == "jj" ]]; then
  version=$(release_version_at @)
  [[ -n "${version}" ]] && info "Re-preparing ${version} (already on @)"
fi

if [[ -z "${version}" && "${FORCE}" == "false" && "${SKIP_CLEAN}" == "false" ]]; then
  if [[ "${VCS}" == "jj" ]]; then
    dirty=$(jj diff -r @ --summary 2>/dev/null | grep -v '^$' || true)
    if [[ -n "${dirty}" ]]; then
      warn "Working copy (@) has uncommitted changes:"
      jj diff -r @ --summary 2>/dev/null | sed 's/^/       /'
      echo ""
      die "Run \`jj new\` first, or pass --skip-clean to skip this check."
    fi
  else
    dirty=$(git status --porcelain | grep -v '^??' || true)
    if [[ -n "${dirty}" ]]; then
      warn "Working tree has uncommitted changes:"
      awk '{print "       " $0}' <<< "${dirty}"
      echo ""
      die "Commit or stash changes first, or pass --skip-clean to skip this check."
    fi
  fi
fi

# ── cog check ─────────────────────────────────────────────────────────────────
if [[ "${FORCE}" == "false" && "${SKIP_COG}" == "false" ]]; then
  info "Checking conventional commits…"
  cog check 2>&1 | sed 's/^/       /' || die "cog check failed — fix commits before releasing, or pass --skip-cog."
  success "Conventional commits OK"
  echo ""
fi

# ── bump + changelog ──────────────────────────────────────────────────────────
if [[ -z "${version}" ]]; then
  raw_version=$(${CLIFF} --bumped-version "${CLIFF_REV[@]}" 2>/dev/null || echo "0.1.0")
  version="v${raw_version#v}"  # ensure v prefix
  info "Bumped version: ${version}"
fi

# git cliff resolves the bump from the latest tag; a submodule tag winning that
# race yields something like "parsers/toml/v0.5.1", and every go.mod would be
# pinned to it. Set tag_pattern = "^v[0-9]" in .config/cliff.toml to prevent
# that; this guard catches the repo that forgot to. Cheap to check, expensive
# to undo.
[[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]] \
  || die "git cliff resolved '${raw_version:-${version}}' — check tag_pattern in .config/cliff.toml"

CLIFF_EXTRA=()
if [[ -n "${HIGHLIGHTS}" ]]; then
  CLIFF_EXTRA=(--with-tag-message "${HIGHLIGHTS}")
  info "Highlights: ${HIGHLIGHTS}"
fi

${CLIFF} --tag "${version}" "${CLIFF_REV[@]}" "${CLIFF_EXTRA[@]}" -o CHANGELOG.md
success "CHANGELOG.md updated"

info "Formatting CHANGELOG.md…"
hk fix CHANGELOG.md
success "CHANGELOG.md formatted"

# ── update go.mod files: pin monorepo versions + strip replace directives ─────
# A module that another module in the workspace imports gets its require pinned
# to the version about to be tagged, and its local replace dropped. Modules the
# repo never cross-imports pass through untouched.
info "Pinning monorepo module versions in go.mod files…"
discover_modules
for dir in "${MODULE_DIRS[@]}"; do
  pushd "$dir" > /dev/null
  for mod in "${MONOREPO_MODULES[@]}"; do
    # Pin version if already required (ignores modules not in this module's deps)
    if grep -q "\"${mod}\"" go.mod 2>/dev/null || grep -q "${mod} v" go.mod 2>/dev/null; then
      go mod edit -require="${mod}@${version}" 2>/dev/null || true
    fi
    # Strip intra-monorepo replace directives
    go mod edit -dropreplace="${mod}" 2>/dev/null || true
  done
  popd > /dev/null
done
success "go.mod files updated"

# ── update go.work: its local replaces pin the same upcoming versions ────────
# The go.mod files now require ${version} of every monorepo module they depend
# on, and the proxy cannot serve those until the tags exist. go.work resolves
# exactly those versions to this checkout, so a stale or missing pin here
# breaks every build between prepare and push with "unknown revision
# ${version}" — the workspace `use` list alone does not cover it. A submodule
# required by another submodule needs a pin, and so does the root module when a
# submodule requires it back. Edited with sed rather than `go work edit` to
# keep the comment above the directives.
if [[ -f go.work ]]; then
  info "Pinning monorepo replaces in go.work…"
  GO_MOD_FILES=()
  for dir in "${MODULE_DIRS[@]}"; do
    [[ "$dir" == "." ]] && GO_MOD_FILES+=("go.mod") || GO_MOD_FILES+=("$dir/go.mod")
  done
  for i in "${!MONOREPO_MODULES[@]}"; do
    mod="${MONOREPO_MODULES[$i]}"
    dir="${MODULE_DIRS[$i]}"
    [[ "$dir" == "." ]] || dir="./${dir}"
    if grep -q "^replace ${mod} v" go.work; then
      sed -i.bak "s|^replace ${mod} v[^ ]* => .*|replace ${mod} ${version} => ${dir}|" go.work
      rm -f go.work.bak
    elif grep -qE "^[[:space:]]*${mod} v" "${GO_MOD_FILES[@]}"; then
      # Depended on by a sibling module: it needs a pin from now on.
      printf '\nreplace %s %s => %s\n' "${mod}" "${version}" "${dir}" >> go.work
    fi
  done
  success "go.work updated"
fi

# ── jj: describe the working copy and move the bookmark ───────────────────────
# Both are local and reversible (jj undo, jj describe again, mise run
# release:rollback), so doing them here costs nothing and buys the review: what
# gets reviewed is the actual release commit.
#
# The tags are release:push's job. A tag makes its commit immutable under jj, so
# tagging here would push the working copy onto a fresh empty child — moving the
# reviewer off the commit they were just asked to review and leaving `jj diff`
# empty. Describing @ leaves it mutable and in place, so `jj diff`, `jj show`
# and amending all behave normally.
#
# Under git the commit stays in push too, where an unwanted commit costs a reset.
if [[ "${VCS}" == "jj" ]]; then
  echo ""
  jj describe -m "chore(release): ${version}"
  JJ_HEAD=$(jj log -r @ --no-graph --template 'commit_id')
  advance_main_bookmark "${JJ_HEAD}"
fi

echo ""
echo -e "  Review the changelog and go.mod changes, then run:"
echo -e "  ${bold}mise run release:push${reset}"
echo -e "  Changed your mind? ${bold}mise run release:rollback${reset}"
if [[ -z "${HIGHLIGHTS}" ]]; then
  echo ""
  echo -e "  ${cyan}Tip:${reset} Add release highlights with:"
  echo -e "  ${bold}mise run release:prepare --highlights \"Your highlight text\"${reset}"
fi
echo ""
