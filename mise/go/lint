#!/usr/bin/env bash
#MISE description="Run all linters across workspace modules"
#MISE sources=["**/*.go", ".config/golangci.yml", "go.work"]
#USAGE flag "--no-cache" help="Bust golangci-lint cache before running (runs 'golangci-lint cache clean')"
#USAGE arg "[args]..." help="Extra flags forwarded to golangci-lint run"
set -euo pipefail
# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

lintargs=()
for arg in "$@"; do
  case "$arg" in
    --no-cache) golangci-lint cache clean ;;
    *) lintargs+=("$arg") ;;
  esac
done

root=$(pwd)
failed=0
while IFS= read -r mod; do
  echo "==> $mod"
  # ${a[@]+"${a[@]}"} rather than "${a[@]}": stock macOS bash is 3.2, where
  # set -u treats an empty array expansion as an unbound variable.
  if ! (cd "$root/$mod" && golangci-lint run -c "$root/.config/golangci.yml" ${lintargs[@]+"${lintargs[@]}"}); then
    echo "FAIL lint: $mod"
    failed=1
  fi
done < <(workspace_module_dirs)

dprint check -c .config/dprint.json
exit $failed
