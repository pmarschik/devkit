#!/usr/bin/env bash
#MISE description="Tidy all workspace modules (parallel)"
#MISE sources=["**/go.mod", "**/go.sum", "go.work"]
set -euo pipefail
# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

root=$(pwd)
pids=()
mods=()

while IFS= read -r mod; do
  mods+=("$mod")
  (cd "$root/$mod" && go mod tidy) &
  pids+=($!)
done < <(workspace_module_dirs)

failed=0
for i in "${!pids[@]}"; do
  if ! wait "${pids[$i]}"; then
    echo "FAIL tidy: ${mods[$i]}"
    failed=1
  fi
done
exit $failed
