#!/usr/bin/env bash
#MISE description="Compose .config/golangci.yml from devkit's shared config and this repo's overrides"
#USAGE flag "-n --diff-only" help="Show what would change and exit non-zero if it differs"
set -euo pipefail

# golangci-lint has no config inheritance. Neither `extends` nor `include` is in
# its schema — `golangci-lint config verify` rejects both — so the shared config
# cannot be referenced the way dprint and hk reference theirs. It gets composed
# here instead and the result is committed, because every editor, CI job and
# `golangci-lint run` reads a plain file at .config/golangci.yml.
#
# The composition is devkit's golangci/go.yml, deep-merged with this repo's
# optional .config/golangci.overrides.yml. That split is what keeps a consumer
# with an unusual budget or a per-path exemption from drifting off the shared
# config entirely: the overrides file holds the delta, the base keeps arriving.
#
# The task lives inside the devkit clone that mise cached for the include, so
# the base sits at a fixed path next to it, already at the ref this repo pinned.
SOURCE="$(cd "$(dirname "$0")/../.." && pwd)/golangci/go.yml"
OVERRIDES=".config/golangci.overrides.yml"
TARGET=".config/golangci.yml"

[[ -f "${SOURCE}" ]] || { echo "shared config not found at ${SOURCE}" >&2; exit 1; }

# The merge is a deep merge where a value in the overrides file wins, and an
# array is a value: writing `paths` or `tagalign.order` in the overrides file
# replaces the shared list rather than extending it. That rule is worth the
# restating it sometimes costs, because appending cannot remove an entry and a
# half-append/half-replace scheme is impossible to predict from reading either
# file.
#
# linters.enable is the one exception, because it is the key a consumer most
# often wants to add one item to. It is the union of every document's enable
# list, minus linters.disable. A repo drops a shared linter by naming it under
# disable — leaving it in both lists would make golangci-lint reject the config,
# so the subtraction takes it back out of enable. A linter that comes from
# `default: standard` is not in enable at all, so it stays in disable and is
# switched off the way golangci-lint intends.
#
# The generated enable list carries no comments: it is rebuilt from the union
# rather than merged in place. Every other key keeps the comments its source
# file wrote.
# shellcheck disable=SC2016 # $item is a yq variable, not a shell one
MERGE='. as $item ireduce ({}; . * $item)'

# yq is not in any consumer's [tools]: this task runs by hand a few times a
# year, so a one-off resolve costs less than a tool every repo has to carry.
yq() { mise exec yq@latest -- yq "$@"; }

compose() {
  local out=$1 sources=("${SOURCE}") enabled
  [[ -f "${OVERRIDES}" ]] && sources+=("${OVERRIDES}")

  # A compact JSON array, spliced into the merge expression below as a yq array
  # literal. yq reads its own JSON output, so no quoting translation is needed.
  enabled=$(yq eval-all -o=json -I=0 '[.] | map(.linters.enable // []) | flatten | unique' "${sources[@]}")

  {
    echo "# Generated by \`mise run sync-golangci\`. Do not edit."
    echo "#"
    echo "# Base:      devkit golangci/go.yml, at the ref .config/mise/config.toml pins."
    if [[ -f "${OVERRIDES}" ]]; then
      echo "# Overrides: ${OVERRIDES}"
    else
      echo "# Overrides: none — add ${OVERRIDES} to diverge from the base."
    fi
    echo "#"
    echo "# Edit the base in devkit or the overrides file here, then re-run the task."
    echo "# An edit to this file is lost on the next sync."
    # Clearing the root head comment drops the overrides file's own preamble,
    # which the merge would otherwise paste under the header written above.
    yq eval-all "${MERGE} | .linters.enable = (${enabled} - (.linters.disable // [])) | . head_comment = \"\"" "${sources[@]}"
  } > "${out}"

  # A bad override is worth catching here rather than in the middle of a lint
  # run, where the schema error names the generated file and explains nothing.
  if ! golangci-lint config verify -c "${out}" >/dev/null 2>&1; then
    echo "composed config is not valid golangci-lint configuration:" >&2
    golangci-lint config verify -c "${out}" >&2 || true
    return 1
  fi
}

# A directory rather than `mktemp -t ...yml`: BSD mktemp appends its random
# characters to the template, so the suffix lands mid-name and golangci-lint
# refuses a config file it cannot recognize by extension.
tmpdir=$(mktemp -d)
trap 'rm -rf "${tmpdir}"' EXIT
composed="${tmpdir}/golangci.yml"
compose "${composed}"

if [[ "${usage_diff_only:-false}" == "true" ]]; then
  if [[ -f "${TARGET}" ]] && diff -u "${TARGET}" "${composed}"; then
    echo "${TARGET} is up to date"
    exit 0
  fi
  [[ -f "${TARGET}" ]] || echo "${TARGET} does not exist"
  exit 1
fi

cp "${composed}" "${TARGET}"
if [[ -f "${OVERRIDES}" ]]; then
  echo "${TARGET} composed from devkit + ${OVERRIDES}"
else
  echo "${TARGET} synced from devkit"
fi
