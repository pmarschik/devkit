#!/usr/bin/env bash
#MISE description="Update go.sum files post-publish — recovery step; release:push runs this automatically"
set -euo pipefail
# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

# go.sum entries for cross-module workspace deps can only be computed after the
# new version exists on the proxy. release:push does this itself; this task is
# for the case where the proxy was still catching up when it ran. Commit the
# resulting go.sum changes as an untagged housekeeping commit.

echo ""
echo -e "${bold}🔑 Post-release go.sum tidy…${reset}"
echo ""

detect_vcs
discover_modules

version=$(git tag --sort=-version:refname | grep '^v[0-9]' | head -1)
[[ -n "${version}" ]] || die "no version tag found — run 'mise run release:push' first"
info "Version: ${bold}${version}${reset}"

info "Waiting for proxy to serve ${version}…"
wait_for_proxy "${version}" \
  || die "Timed out — proxy not serving ${version} yet. Retry later."
success "Proxy is serving ${version}"

tidy_go_sums

echo ""
echo -e "  Review the go.sum changes, then commit and push:"
echo -e "  ${bold}jj commit -m \"chore: update go.sum after ${version}\"${reset}"
echo ""
