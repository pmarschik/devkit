#!/usr/bin/env bash
#MISE description="Publish the prepared release and tidy go.sum after verification"
#USAGE flag "-n --dry-run" help="Check the prepared release and print what would be pushed"
set -euo pipefail
# shellcheck source=_lib.sh
source "$(dirname "$0")/_lib.sh"

DRY_RUN="${usage_dry_run:-false}"

echo ""
if [[ "${DRY_RUN}" == "true" ]]; then
  echo -e "${bold}🚀 Releasing (dry run)…${reset}"
else
  echo -e "${bold}🚀 Releasing…${reset}"
fi
echo ""

# ── detect VCS ───────────────────────────────────────────────────────────────
detect_vcs
info "VCS: ${VCS}"
discover_modules

# ── defensive checks ─────────────────────────────────────────────────────────
if [[ "${VCS}" == "git" ]]; then
  branch=$(git branch --show-current)
  [[ "${branch}" == "main" || "${branch}" == "master" ]] \
    || die "must be on main/master branch (current: ${branch})"

  unexpected=()
  has_changelog=false
  while IFS= read -r path; do
    [[ -z "${path}" ]] && continue
    [[ "${path}" == "CHANGELOG.md" ]] && has_changelog=true
    is_release_prepare_path "${path}" || unexpected+=("${path}")
  done < <(git diff --name-only HEAD --)

  [[ ${#unexpected[@]} -eq 0 ]] \
    || die "unexpected uncommitted changes — only release:prepare outputs expected:\n${unexpected[*]}"
  [[ "${has_changelog}" == "true" ]] \
    || die "CHANGELOG.md has no pending changes — run 'mise run release:prepare' first"
fi

# ── resolve version ──────────────────────────────────────────────────────────
# Under jj the release is already committed and tagged by release:prepare, so
# the version comes from that commit; git cliff would answer with the next one.
if [[ "${VCS}" == "jj" ]]; then
  RELEASE_REV="@"
  version=$(release_version_at @)
  if [[ -z "${version}" && -z "$(jj diff -r @ --summary 2>/dev/null)" ]]; then
    version=$(release_version_at @-)
    if [[ -n "${version}" ]]; then
      RELEASE_REV="@-"
      info "Using prepared release at @- (empty working-copy child at @)"
    fi
  fi
  [[ -n "${version}" ]] \
    || die "neither @ nor the parent of an empty @ is a release commit — run 'mise run release:prepare' first"
else
  raw_version=$(git cliff --config .config/cliff.toml --bumped-version 2>/dev/null) \
    || die "could not determine version from git cliff"
  version="v${raw_version#v}"  # ensure v prefix
fi
info "Version: ${bold}${version}${reset}"

# git cliff resolves the bump from the latest tag; a submodule tag winning that
# race yields something like "parsers/toml/v0.5.1", and every go.mod would be
# pinned to it. Set tag_pattern = "^v[0-9]" in .config/cliff.toml to prevent
# that; this guard catches the repo that forgot to. Cheap to check, expensive
# to undo.
[[ "${version}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+ ]] \
  || die "git cliff resolved '${raw_version:-${version}}' — check tag_pattern in .config/cliff.toml"

# ── extract highlights ────────────────────────────────────────────────────────
HIGHLIGHTS=$(awk '/^## \[/{found=1; next} found && /^###/{exit} found && NF{print}' CHANGELOG.md | sed 's/^[[:space:]]*//')
[[ -n "${HIGHLIGHTS}" ]] && info "Highlights: ${HIGHLIGHTS}"
echo ""

# ── dry run: verify the prepared state, then report and stop ──────────────────
# Nothing below this point runs, so a dry run reaches no remote and changes no
# local state either.
if [[ "${DRY_RUN}" == "true" ]]; then
  expected_release_tags "${version}"
  if [[ "${VCS}" == "jj" ]]; then
    RELEASE_COMMIT=$(jj log -r "${RELEASE_REV}" --no-graph --template 'commit_id')
    verify_jj_prepared_release "${version}" "${RELEASE_COMMIT}"
    success "Prepared release state verified at ${RELEASE_REV} (${RELEASE_COMMIT:0:12})"
  fi
  info "Would push bookmark main, then tag ${version}, then $((${#RELEASE_TAGS[@]} - 1)) module tags:"
  printf '         %s\n' "${RELEASE_TAGS[@]:1}"
  info "Would open or update the GitHub release ${version} from CHANGELOG.md"
  info "Would wait for the proxy to serve ${ROOT_MODULE}@${version}, tidy go.sum and commit"
  echo ""
  echo -e "  ${green}${bold}✓ Dry run only — nothing was pushed.${reset}"
  echo ""
  exit 0
fi

# ── confirm ──────────────────────────────────────────────────────────────────
confirm "Push ${version} and tidy go.sum?" \
  || { warn "Aborted."; echo ""; exit 0; }
echo ""

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 1 — commit + tag (jj did both in release:prepare)
# ═══════════════════════════════════════════════════════════════════════════════
if [[ "${VCS}" == "git" ]]; then
  stage_release_prepare_changes
  git commit -m "chore(release): ${version}"
  success "Committed: chore(release): ${version}"
  create_release_tags "${version}" "$(git rev-parse HEAD)"
else
  RELEASE_COMMIT=$(jj log -r "${RELEASE_REV}" --no-graph --template 'commit_id')
  verify_jj_prepared_release "${version}" "${RELEASE_COMMIT}"
  success "Prepared release state verified"

  # Keep post-release go.sum changes off the tagged release commit. A normal jj
  # workflow already has an empty child; create one when prepare left @ itself
  # as the release commit.
  if [[ "${RELEASE_REV}" == "@" ]]; then
    jj new "${RELEASE_COMMIT}"
  fi
fi

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 2 — push (requires hardware key touch)
# ═══════════════════════════════════════════════════════════════════════════════
echo ""
info "Pushing… (hardware key touch required)"

# The branch goes alone so the staged tag pushes below stay separate.
# --bookmark keeps every local tag out of this push.
if [[ "${VCS}" == "jj" ]]; then
  jj git push --bookmark main
else
  HK=0 git push origin HEAD
fi
success "Branch pushed"

# Root tag alone — GitHub suppresses push events when >3 tags arrive at once,
# and .github/workflows/release.yml listens for exactly this one.
info "Pushing root tag ${version} (triggers GitHub Actions)…"
if [[ "${VCS}" == "jj" ]]; then
  jj git push --tag "${version}"
else
  HK=0 git push origin "refs/tags/${version}"
fi
success "Root tag pushed"

# The module tags carry no artifacts — they are how `go get` finds each module
# at this version — so they can all go at once, after the root tag.
info "Pushing sub-module tags…"
if [[ "${VCS}" == "jj" ]]; then
  expected_release_tags "${version}"
  SUBMODULE_TAG_ARGS=()
  for name in "${RELEASE_TAGS[@]:1}"; do
    SUBMODULE_TAG_ARGS+=(--tag "${name}")
  done
  if [[ ${#SUBMODULE_TAG_ARGS[@]} -gt 0 ]]; then
    jj git push "${SUBMODULE_TAG_ARGS[@]}"
  fi
else
  HK=0 git push --tags
fi
success "Sub-module tags pushed"

# GoReleaser, where a repo runs it, opens the release when the root tag lands
# but leaves the notes to whatever it generates. This writes the changelog
# section instead, and covers the case where the workflow never fired.
info "Updating GitHub release notes…"
notes=$(awk '/^## \[/{if(p) exit; p=1; next} p' CHANGELOG.md | sed '/./,$!d')
if gh release view "${version}" &>/dev/null; then
  gh release edit "${version}" --notes "${notes}"
else
  gh release create "${version}" --title "${version}" --notes "${notes}"
fi
success "Release notes updated"

# ═══════════════════════════════════════════════════════════════════════════════
# STEP 3 — wait for proxy, tidy go.sum, commit + push (second key touch)
# ═══════════════════════════════════════════════════════════════════════════════
echo ""
info "Waiting for proxy to serve ${version}…"
if ! wait_for_proxy "${version}"; then
  warn "Proxy timeout — run 'mise run release:post-tidy' later to finish go.sum update."
  echo ""
  echo -e "  ${green}${bold}✓ Release ${version} is live (go.sum tidy pending).${reset}"
  echo ""
  exit 0
fi
success "Proxy is serving ${version}"

tidy_go_sums

if [[ "${VCS}" == "jj" ]]; then
  jj commit -m "chore: update go.sum after ${version}"
else
  git add '*/go.sum' go.sum go.work.sum 2>/dev/null || true
  git commit -m "chore: update go.sum after ${version}"
fi
success "go.sum commit created"

# The tags stay on the release commit; only the branch moves on.
info "Pushing go.sum commit… (hardware key touch required)"
if [[ "${VCS}" == "jj" ]]; then
  advance_main_bookmark "@-"
  jj git push --bookmark main
else
  HK=0 git push origin HEAD
fi
success "go.sum commit pushed"

echo ""
echo -e "  ${green}${bold}✓ Release ${version} is complete.${reset}"
echo ""
