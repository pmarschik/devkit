#!/usr/bin/env bash
#MISE description="Tag a devkit release and move the major tag consumers pin"
#USAGE arg "[version]" help="Version to write (vX.Y.Z). Derived from the commits since the last tag when omitted."
#USAGE flag "-r --revision <revision>" help="Revision to tag" default="main"
#USAGE flag "-n --dry-run" help="Report what would be written and stop"
#USAGE flag "--push" help="Push main and both tags afterwards (hardware key touch)"
#USAGE flag "--skip-check" help="Skip the check task"
#USAGE flag "--force" help="Move an existing vX.Y.Z tag onto another revision"
set -euo pipefail

# devkit is not a Go module, so none of the release tasks in mise/go apply to it:
# there is no proxy to wait for, no go.sum to tidy and no CHANGELOG. Its release
# is two tags on one commit — vX.Y.Z, which records what shipped, and the moving
# vN that every consumer pins through `?ref=v1` and `@v1`.
#
# The two halves reach consumers by different routes and that asymmetry is the
# whole reason this task prints what it does at the end. A `uses:` in a workflow
# resolves the tag on every run, so a moved vN lands in CI at once. A mise
# `[task_config] includes` does not: mise clones the include once, at the commit
# the ref named that day, and a moved ref never invalidates that clone. Consumers
# keep running the old tasks with a clean exit and no warning until the cache is
# cleared by hand.

VERSION="${usage_version:-}"
REVISION="${usage_revision:-main}"
DRY_RUN="${usage_dry_run:-false}"
PUSH="${usage_push:-false}"
SKIP_CHECK="${usage_skip_check:-false}"
FORCE="${usage_force:-false}"

die() { echo "error: $*" >&2; exit 1; }

jj root &>/dev/null || die "not a jj repository"

commit=$(jj log -r "${REVISION}" --no-graph -T 'commit_id' 2>/dev/null) \
  || die "no such revision: ${REVISION}"
[[ -n "${commit}" ]] || die "no such revision: ${REVISION}"

# An empty or undescribed revision is somebody's working copy, not a release.
subject=$(jj log -r "${REVISION}" --no-graph -T 'description.first_line()')
[[ -n "${subject}" ]] || die "${REVISION} has no description — tag the commit, not the working copy"

echo "==> ${REVISION} is ${commit:0:8} ${subject}"

# ── work out the version ──────────────────────────────────────────────────────

# The bare major tags live alongside the semver ones, so the version sort has to
# see only vX.Y.Z or the highest release is whichever major moved last.
last=$(jj tag list -T 'name ++ "\n"' 2>/dev/null \
  | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)

if [[ -z "${VERSION}" ]]; then
  [[ -n "${last}" ]] || die "no vX.Y.Z tag to count from — pass the version explicitly"

  # Conventional commits decide the bump. The exclamation mark and the
  # BREAKING CHANGE trailer are the two spellings of a major, and both are read
  # here because a commit is free to use either.
  range="${last}..${REVISION}"
  subjects=$(jj log -r "${range}" --no-graph -T 'description.first_line() ++ "\n"')
  bodies=$(jj log -r "${range}" --no-graph -T 'description ++ "\n"')
  [[ -n "${subjects//[[:space:]]/}" ]] || die "no commits between ${last} and ${REVISION}"

  if grep -qE '^[a-z]+(\([^)]*\))?!:' <<< "${subjects}" || grep -q 'BREAKING CHANGE' <<< "${bodies}"; then
    bump="major"
  elif grep -qE '^feat(\([^)]*\))?:' <<< "${subjects}"; then
    bump="minor"
  else
    bump="patch"
  fi

  IFS=. read -r major minor patch <<< "${last#v}"
  case "${bump}" in
    major) VERSION="v$((major + 1)).0.0" ;;
    minor) VERSION="v${major}.$((minor + 1)).0" ;;
    patch) VERSION="v${major}.${minor}.$((patch + 1))" ;;
  esac

  echo "==> ${last} -> ${VERSION} (${bump}, from $(grep -c . <<< "${subjects}") commit(s))"
  awk 'NF { print "      " $0 }' <<< "${subjects}"
else
  [[ "${VERSION}" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version must look like vX.Y.Z, got ${VERSION}"
  echo "==> ${VERSION} (given)"
fi

stripped="${VERSION#v}"
major_tag="v${stripped%%.*}"

# ── refuse to rewrite history a consumer may already have ─────────────────────

existing=$(jj log -r "${VERSION}" --no-graph -T 'commit_id' 2>/dev/null || true)
if [[ -n "${existing}" && "${existing}" != "${commit}" && "${FORCE}" != "true" ]]; then
  die "${VERSION} already points at ${existing:0:8} — pick the next version, or pass --force"
fi

# A new major is a new moving tag, and nothing pinned to the old one follows it.
if [[ -z "$(jj log -r "${major_tag}" --no-graph -T 'commit_id' 2>/dev/null || true)" ]]; then
  echo ""
  echo "    ${major_tag} does not exist yet. Consumers pinned to the previous major"
  echo "    stay where they are until their include and uses: lines are repointed."
fi

echo ""
echo "==> tags: ${VERSION}, ${major_tag} -> ${commit:0:8}"

if [[ "${DRY_RUN}" == "true" ]]; then
  echo ""
  echo "Dry run — nothing written."
  exit 0
fi

# ── gate ──────────────────────────────────────────────────────────────────────

if [[ "${SKIP_CHECK}" != "true" ]]; then
  echo ""
  echo "==> check"
  mise run --force check
fi

# ── write the tags ────────────────────────────────────────────────────────────

echo ""
# --allow-move covers both tags: the major one moves by design, and the semver
# one is re-set onto the same commit when a run is repeated after a failed push.
jj tag set "${VERSION}" "${major_tag}" -r "${REVISION}" --allow-move
echo "==> tagged ${VERSION} and ${major_tag}"

push_cmd=(jj git push --bookmark main --tag "${VERSION}" --tag "${major_tag}")

if [[ "${PUSH}" == "true" ]]; then
  echo ""
  echo "==> pushing (touch the hardware key when it asks)"
  "${push_cmd[@]}"
else
  echo ""
  echo "Push it yourself — the commits are signed with a hardware key:"
  echo ""
  echo "    ${push_cmd[*]}"
fi

# The reminder every consumer needs and no consumer is told by anything else.
echo ""
echo "Then clear the mise clone of the include on every machine that uses it,"
echo "or ${major_tag} moves and the tasks do not:"
echo ""
echo "    rm -rf \"\$(mise cache path)/remote-git-tasks-cache\" && mise tasks ls"
